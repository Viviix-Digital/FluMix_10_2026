  m_Script: {fileID: 0}
  m_Name: QuestionBank
  m_EditorClassIdentifier: Assembly-CSharp:FluMix:QuestionBank
  questions:
  - prompt: "C\xFAm m\xF9a l\xE0 b\u1EC7nh do nguy\xEAn nh\xE2n n\xE0o g\xE2y ra?"
    options:
    - "Vi khu\u1EA9n"
    - "Virus c\xFAm"
    - "Thay \u0111\u1ED5i th\u1EDDi ti\u1EBFt"
    - "D\u1ECB \u1EE9ng"
    correctIndex: 1
    affirmation: "C\xFAm m\xF9a do virus c\xFAm g\xE2y ra"
    body: "Kh\xF4ng ph\u1EA3i do th\u1EDDi ti\u1EBFt l\u1EA1nh hay thay \u0111\u1ED5i
      nhi\u1EC7t \u0111\u1ED9. Virus c\xFAm A v\xE0 B l\xE0 c\xE1c t\xE1c nh\xE2n
      g\xE2y c\xFAm m\xF9a \u1EDF ng\u01B0\u1EDDi."
    citation: "T\xE0i li\u1EC7u tham kh\u1EA3o: Krammer F, et al. Nat Rev Dis Primers.
      2018;4:3"
  - prompt: "Virus c\xFAm m\xF9a \u1EDF ng\u01B0\u1EDDi ch\u1EE7 y\u1EBFu thu\u1ED9c
      nh\xF3m n\xE0o?"
    options:
    - "Ch\u1EC9 virus c\xFAm C"
    - "Virus c\xFAm A v\xE0 B"
    - "Vi khu\u1EA9n t\u1EE5 c\u1EA7u"
    - "N\u1EA5m men"
    correctIndex: 1
    affirmation: "Ch\u1EE7 y\u1EBFu l\xE0 virus c\xFAm A v\xE0 B"
    body: "Virus c\xFAm A v\xE0 B g\xE2y c\xFAm m\xF9a \u1EDF ng\u01B0\u1EDDi. Virus
      c\xFAm C th\u01B0\u1EDDng nh\u1EB9 h\u01A1n. Vi khu\u1EA9n v\xE0 n\u1EA5m kh\xF4ng
      g\xE2y b\u1EC7nh c\xFAm m\xF9a."
    citation: 
  - prompt: "C\xFAm m\xF9a l\xE2y ch\u1EE7 y\u1EBFu b\u1EB1ng c\xE1ch n\xE0o?"
    options:
    - "Mu\u1ED7i \u0111\u1ED1t"
    - "Gi\u1ECDt b\u1EAFn khi ho, h\u1EAFt h\u01A1i"
    - "\u0102n ph\u1EA3i th\u1EE9c \u0103n \xF4i"
    - "T\u1EAFm n\u01B0\u1EDBc l\u1EA1nh"
    correctIndex: 1
    affirmation: "C\xFAm m\xF9a l\xE2y qua gi\u1ECDt b\u1EAFn h\xF4 h\u1EA5p"
    body: "Virus theo gi\u1ECDt b\u1EAFn khi ng\u01B0\u1EDDi b\u1EC7nh ho, h\u1EAFt
      h\u01A1i ho\u1EB7c n\xF3i chuy\u1EC7n g\u1EA7n. Mu\u1ED7i v\xE0 th\u1EE9c \u0103n
      \xF4i kh\xF4ng ph\u1EA3i \u0111\u01B0\u1EDDng l\xE2y ch\xEDnh."
    citation: 
  - prompt: "Tri\u1EC7u ch\u1EE9ng n\xE0o th\u01B0\u1EDDng g\u1EB7p khi m\u1EAFc
      c\xFAm m\xF9a?"
    options:
    - "S\u1ED1t, \u0111au h\u1ECDng, \u0111au m\xECnh"
    - "Ch\u1EC9 ng\u1EE9a da"
    - "Ch\u1EC9 \u0111au r\u0103ng"
    - "Ch\u1EC9 s\u01B0ng kh\u1EDBp"
    correctIndex: 0
    affirmation: "C\xFAm m\xF9a th\u01B0\u1EDDng c\xF3 s\u1ED1t, \u0111au h\u1ECDng
      v\xE0 \u0111au m\xECnh"
    body: "B\u1EC7nh th\u01B0\u1EDDng kh\u1EDFi ph\xE1t \u0111\u1ED9t ng\u1ED9t v\u1EDBi
      s\u1ED1t, \u0111au \u0111\u1EA7u, \u0111au c\u01A1 v\xE0 \u0111au h\u1ECDng.
      Ng\u1EE9a da \u0111\u01A1n \u0111\u1ED9c kh\xF4ng ph\u1EA3i d\u1EA5u hi\u1EC7u
      \u0111i\u1EC3n h\xECnh."
    citation: 
  - prompt: "C\xE1ch n\xE0o gi\xFAp h\u1EA1n ch\u1EBF l\xE2y c\xFAm m\xF9a?"
    options:
    - "Che mi\u1EC7ng khi ho v\xE0 r\u1EEDa tay"
    - "D\xF9ng chung kh\u0103n m\u1EB7t"
    - "\u0110\u1EBFn n\u01A1i \u0111\xF4ng ng\u01B0\u1EDDi khi \u0111ang s\u1ED1t"
    - "T\u1EADp luy\u1EC7n d\u01B0\u1EDBi m\u01B0a"
    correctIndex: 0
    affirmation: "Che mi\u1EC7ng khi ho v\xE0 r\u1EEDa tay gi\xFAp h\u1EA1n ch\u1EBF
      l\xE2y"
    body: "R\u1EEDa tay, che mi\u1EC7ng khi ho v\xE0 \u1EDF nh\xE0 khi s\u1ED1t l\xE0m
      gi\u1EA3m ph\xE1t t\xE1n virus. D\xF9ng chung kh\u0103n v\xE0 \u0111\u1EBFn
      ch\u1ED7 \u0111\xF4ng ng\u01B0\u1EDDi l\xE0m t\u0103ng l\xE2y lan."
    citation: 
  - prompt: "Kh\xE1ng sinh c\xF3 ch\u1EEFa kh\u1ECFi c\xFAm m\xF9a do virus kh\xF4ng?"
    options:
    - "C\xF3, v\xEC kh\xE1ng sinh di\u1EC7t virus"
    - "Kh\xF4ng, kh\xE1ng sinh kh\xF4ng di\u1EC7t virus"
    - "Ch\u1EC9 khi tr\u1EDDi l\u1EA1nh"
    - "Ch\u1EC9 v\u1EDBi ng\u01B0\u1EDDi l\u1EDBn"
    correctIndex: 1
    affirmation: "Kh\xE1ng sinh kh\xF4ng di\u1EC7t virus c\xFAm"
    body: "C\xFAm m\xF9a do virus. Kh\xE1ng sinh ch\u1EC9 d\xF9ng khi th\u1EA7y thu\u1ED1c
      x\xE1c \u0111\u1ECBnh c\xF3 b\u1ED9i nhi\u1EC5m vi khu\u1EA9n, kh\xF4ng ph\u1EA3i
      thu\u1ED1c tr\u1ECB virus c\xFAm."
    citation: 
  - prompt: "C\xFAm m\xF9a kh\xE1c c\u1EA3m l\u1EA1nh \u1EDF \u0111i\u1EC3m n\xE0o?"
    options:
    - "C\xFAm th\u01B0\u1EDDng s\u1ED1t cao v\xE0 kh\u1EDFi ph\xE1t \u0111\u1ED9t
      ng\u1ED9t"
    - "Hai b\u1EC7nh do c\xF9ng m\u1ED9t vi khu\u1EA9n"
    - "C\u1EA3m l\u1EA1nh lu\xF4n s\u1ED1t r\u1EA5t cao"
    - "C\xFAm kh\xF4ng l\xE2y sang ng\u01B0\u1EDDi kh\xE1c"
    correctIndex: 0
    affirmation: "C\xFAm th\u01B0\u1EDDng s\u1ED1t cao h\u01A1n v\xE0 \u0111\u1EBFn
      \u0111\u1ED9t ng\u1ED9t"
    body: "C\u1EA3m l\u1EA1nh th\u01B0\u1EDDng nh\u1EB9, di\u1EC5n ti\u1EBFn t\u1EEB
      t\u1EEB. C\xFAm m\xF9a hay b\u1EAFt \u0111\u1EA7u \u0111\u1ED9t ng\u1ED9t v\u1EDBi
      s\u1ED1t cao v\xE0 m\u1EC7t nhi\u1EC1u. C\u1EA3 hai \u0111\u1EC1u c\xF3 th\u1EC3
      l\xE2y."
    citation: 
  - prompt: "Ai n\xEAn ti\xEAm v\u1EAFc xin c\xFAm h\u1EB1ng n\u0103m?"
    options:
    - "Kh\xF4ng ai c\u1EA7n ti\xEAm"
    - "Ng\u01B0\u1EDDi c\xF3 nguy c\u01A1 cao v\xE0 ng\u01B0\u1EDDi ch\u0103m s\xF3c
      h\u1ECD"
    - "Ch\u1EC9 v\u1EADn \u0111\u1ED9ng vi\xEAn"
    - "Ch\u1EC9 tr\u1EBB d\u01B0\u1EDBi m\u1ED9t th\xE1ng tu\u1ED5i"
    correctIndex: 1
    affirmation: "Ng\u01B0\u1EDDi c\xF3 nguy c\u01A1 cao v\xE0 ng\u01B0\u1EDDi ch\u0103m
      s\xF3c n\xEAn ti\xEAm h\u1EB1ng n\u0103m"
    body: "V\u1EAFc xin c\xFAm \u0111\u01B0\u1EE3c nh\u1EAFc l\u1EA1i m\u1ED7i n\u0103m
      v\xEC virus thay \u0111\u1ED5i. Ng\u01B0\u1EDDi b\u1EC7nh m\u1EA1n t\xEDnh,
      ng\u01B0\u1EDDi l\u1EDBn tu\u1ED5i v\xE0 ng\u01B0\u1EDDi ch\u0103m s\xF3c h\u1ECD
      thu\u1ED9c nh\xF3m n\xEAn ti\xEAm."
    citation: 
  - prompt: "Khi b\u1ECB c\xFAm m\xF9a, vi\u1EC7c n\xEAn l\xE0m tr\u01B0\u1EDBc l\xE0
      g\xEC?"
    options:
    - "Ngh\u1EC9 ng\u01A1i, u\u1ED1ng \u0111\u1EE7 n\u01B0\u1EDBc, h\u1EA1n ch\u1EBF
      ti\u1EBFp x\xFAc"
    - "\u0110\u1EBFn ch\u1ED7 \u0111\xF4ng ng\u01B0\u1EDDi"
    - "D\xF9ng chung \u0111\u1ED3 \u0103n"
    - "T\u1EADp n\u1EB7ng ngay"
    correctIndex: 0
    affirmation: "N\xEAn ngh\u1EC9, u\u1ED1ng \u0111\u1EE7 n\u01B0\u1EDBc v\xE0 h\u1EA1n
      ch\u1EBF ti\u1EBFp x\xFAc"
    body: "Ngh\u1EC9 ng\u01A1i v\xE0 u\u1ED1ng \u0111\u1EE7 n\u01B0\u1EDBc gi\xFAp
      c\u01A1 th\u1EC3 h\u1ED3i ph\u1EE5c. H\u1EA1n ch\u1EBF ti\u1EBFp x\xFAc \u0111\u1EC3
      b\u1EDBt l\xE2y cho ng\u01B0\u1EDDi xung quanh."
    citation: 
  - prompt: "D\u1EA5u hi\u1EC7u n\xE0o c\u1EA7n \u0111i kh\xE1m s\u1EDBm khi nghi
      c\xFAm?"
    options:
    - "Kh\xF3 th\u1EDF, s\u1ED1t cao k\xE9o d\xE0i, l\u1EEB \u0111\u1EEB"
    - "H\u1EAFt h\u01A1i m\u1ED9t c\xE1i r\u1ED3i kh\u1ECFi"
    - "Ng\u1EE7 th\xEAm m\u1ED9t gi\u1EA5c"
    - "Ch\u1EC9 kh\xE1t n\u01B0\u1EDBc nh\u1EB9"
    correctIndex: 0
    affirmation: "Kh\xF3 th\u1EDF, s\u1ED1t cao k\xE9o d\xE0i ho\u1EB7c l\u1EEB \u0111\u1EEB
      c\u1EA7n \u0111i kh\xE1m"
    body: "Kh\xF3 th\u1EDF, s\u1ED1t cao kh\xF4ng h\u1EA1, li b\xEC ho\u1EB7c t\xEDm
      m\xF4i l\xE0 d\u1EA5u hi\u1EC7u c\u1EA7n \u0111\u01B0\u1EE3c kh\xE1m s\u1EDBm,
      nh\u1EA5t l\xE0 v\u1EDBi tr\u1EBB nh\u1ECF v\xE0 ng\u01B0\u1EDDi c\xF3 b\u1EC7nh
      n\u1EC1n."
    citation: 
