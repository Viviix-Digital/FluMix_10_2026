  - id: warn.title
    text: "C\u1EA2NH B\xC1O D\u1ECACH"
  - id: explain.correct
    text: "B\u1EA1n tr\u1EA3 l\u1EDDi \u0111\xFAng!"
  - id: explain.wrong
    text: "Ch\u01B0a \u0111\xFAng!"
  - id: result.title
    text: "K\u1EBET QU\u1EA2"
  - id: result.score
